#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>
#include <math.h>

int isPrime(int status){
    if (status < 2) return 0;
    
    for(int i = 2; i * i <= status; i++){ 
        if(status % i == 0) {
            return 0; 
        }
    }
    return 1;
}


int main() {
    pid_t pid = fork();
    int status = 0;
    if (pid == 0) {
        printf("inserisci il codice da ritornare\n");
        scanf("%d", &status);
        
        if (isPrime(status)) exit(1);
        else if (status % 2 == 0){
            exit(2);
        } else {
            exit(3);
        }
        
    } else {
        pid_t child_pid = wait(&status);

        if (WIFEXITED(status)) {
            int exit_code = WEXITSTATUS(status);
            switch (exit_code){
                case 1:
                    printf("numero figlio primo \n");
                    break;
                case 2:
                    printf("numero figlio pari \n");
                    break;
                case 3:
                    printf("numero figlio dispari \n");
                    break;
            }
        } else {
            printf("Il figlio è terminato in modo anomalo.\n");
        }
    }

    return 0;
}
