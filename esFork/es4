#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

int main() {
    pid_t pid = fork();
    int codice = 0;
    if (pid == 0) {
        printf("inserisci il codice da ritornare\n");
        scanf("%d", &codice);
        
        int c = 0;
        
        for (int i = 1; i <= codice; i++) {
            if (codice % i == 0)
                c++;
        }
        
        if (c == 2){
            exit(1);
        }
        else if (codice % 2 == 0){
            exit(2);
        } else {
            exit(3);
        }
        
    } else {
        int status;
        pid_t child_pid = wait(&status);

        if (WIFEXITED(status)) {
            int exit_code = WEXITSTATUS(status);
            switch (exit_code){
                case 1:
                    printf("numero figlio primo \n");
                    break;
                case 2:
                    printf("numero figlio pari \n");
                    break;
                case 3:
                    printf("numero figlio dispari \n");
                    break;
            }
        } else {
            printf("Il figlio è terminato in modo anomalo.\n");
        }
    }

    return 0;
}
