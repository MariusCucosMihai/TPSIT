#include <stdio.h>
#include <unistd.h>
#include <stdlib.h>
#include <sys/types.h>
#include <sys/wait.h>

int main(void) {
    pid_t p = fork();
    
    if (p < 0){
        perror("ERRORE!!");
        exit(-1);
    } else if (p == 0){
        for (int i = 1; i < 6; i++){
            printf("figlio n %d \n", i);
            sleep(1);
        }
        exit(0);
    }
    
    wait(NULL);
    for (int i = 6; i < 11; i++){
        printf("padre n %d \n", i);
        sleep(1);
    }
    return 0;
}
