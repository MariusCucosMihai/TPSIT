#include <stdio.h>
#include <unistd.h>
#include <stdlib.h>
#include <sys/types.h>
#include <sys/wait.h>

int main()
{
    pid_t p = fork();
    
    if (p < 0){
        printf("errore");
        exit(-1);
    }
    if (p == 0){
        printf("p figlio pid %d \n", getpid());
        pid_t p2 = fork();
        if (p2 < 0){
            printf("errore");
            exit(-1);
        }
        if (p2 == 0){
            printf("p nipote con pid %d \n", getpid());
            exit(0);
        }
        wait(NULL);
        exit(0);
    }
    wait(NULL);
    printf("processo padre \n");

    return 0;
}
